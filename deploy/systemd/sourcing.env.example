# Save the real file under ~/.config/clapping-hands/sourcing.env with mode 0600.
# All paths must be absolute. The token file contains the token; do not put the
# token value in this environment file or in the unit.
CLAPPING_HANDS_DATA_DIR=@EXISTING_CH_DATA_DIRECTORY@
CLAPPING_HANDS_AUTH_PROFILE_DIR=@EXISTING_AUTHENTICATED_CH_PROFILE@
CLAPPING_HANDS_CHROME_PATH=@CHROME_BINARY@
CLAPPING_HANDS_SOURCING_TOKEN_FILE=@OWNER_ONLY_TOKEN_FILE@
CLAPPING_HANDS_SOURCING_PORT=8799
