{
  "name": "clapping-hands",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "Compile browser workflows into typed tools for sites without usable APIs.",
  "type": "module",
  "bin": {
    "clapping-hands": "dist-alpha/src/alpha-server.js"
  },
  "files": [
    "dist-alpha/src",
    "python/*.py",
    "python/requirements.txt",
    "python/requirements-lock.txt",
    "README.md",
    "LICENSE",
    "docs/ONBOARDING.md",
    "docs/RELEASE_PROGRESS.md",
    "docs/RELEASE_COMPLETION_AUDIT.md",
    "docs/RELEASE_CANDIDATE_ACCEPTANCE.md",
    "bench/runs/2026-09-08/openlibrary-packaged-acceptance.json",
    "bench/runs/2026-09-08/node22-package-acceptance.json",
    "bench/runs/2026-09-08/frozen-candidate-acceptance.json",
    "bench/runs/2026-09-08/frozen-marketplace-session.json",
    "bench/runs/2026-09-08/node22-compatibility.json",
    "bench/runs/2026-09-08/saved-json-import.json",
    "docs/SAVED_EVIDENCE_AUDIT.md",
    "bench/runs/2026-09-08/python-locked-install.json",
    "bench/runs/2026-09-08/python-vulnerability-audit.json",
    "bench/runs/2026-09-08/current-package-acceptance.json",
    "bench/runs/2026-09-08/dependent-request-compiler.json",
    "bench/runs/2026-09-08/browser-model-usage.json",
    "bench/runs/2026-09-08/fresh-python-mcp-acceptance.json",
    "bench/runs/2026-09-08/saved-production-evidence-audit.json",
    "docs/JAVASCRIPT_COMPILATION_EXPERIMENT.md",
    "docs/decisions/0010-generated-javascript-runtime.md",
    "bench/runs/2026-09-07/js-compilation-1788790180562.json",
    "docs/COMPILER_RESTORATION.md",
    "docs/TEN_SITE_RESULTS_2026-09-07.md",
    "docs/RICH_WORKFLOW_RESULTS_2026-09-07.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/alpha-server.ts",
    "prepack": "npm run build",
    "setup:browser": "uv venv .venv --python 3.12 && uv pip install --python .venv/bin/python --require-hashes -r python/requirements-lock.txt",
    "smoke:alpha": "tsx scripts/smoke-alpha-runtime.ts",
    "benchmark:ten": "tsx scripts/benchmark-alpha-ten.ts",
    "benchmark:rich": "tsx scripts/benchmark-alpha-rich.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.59",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "7.0.93",
    "cheerio": "1.2.0",
    "playwright-core": "1.62.1",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT"
}
