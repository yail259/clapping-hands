{
  "name": "clapping-hands",
  "version": "0.0.1",
  "private": true,
  "description": "Compile browser workflows into typed tools for sites without usable APIs.",
  "type": "module",
  "bin": {
    "clapping-hands": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "auth:marketplace": "tsx scripts/auth-marketplace.ts",
    "benchmark:live": "tsx scripts/benchmark-live-forms.ts",
    "benchmark:corpus": "tsx scripts/validate-benchmark-corpus.ts",
    "benchmark:controlled": "tsx scripts/benchmark-controlled-general.ts",
    "benchmark:discourse": "tsx scripts/benchmark-discourse.ts",
    "benchmark:marketplace": "tsx scripts/benchmark-marketplace.ts",
    "benchmark:moodle": "tsx scripts/benchmark-moodle.ts",
    "benchmark:nextcloud": "tsx scripts/benchmark-nextcloud.ts",
    "benchmark:osticket": "tsx scripts/benchmark-osticket.ts",
    "benchmark:saucedemo": "tsx scripts/benchmark-saucedemo.ts",
    "benchmark:the-internet": "tsx scripts/benchmark-the-internet.ts",
    "benchmark:wordpress-playground": "tsx scripts/benchmark-wordpress-playground.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/server.ts",
    "dogfood:marketplace": "tsx scripts/dogfood-marketplace.ts",
    "inspect:mcp": "tsx scripts/inspect-mcp.ts",
    "smoke:general": "CLAPPING_HANDS_HEADLESS=true tsx scripts/smoke-general-compiler.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.0.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cheerio": "^1.2.0",
    "playwright-core": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT"
}
