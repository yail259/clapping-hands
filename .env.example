# Optional. A model is needed only for future semantic learning/repair paths.
# Deterministic Marketplace search does not call a model.
CLAPPING_HANDS_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=

# The dedicated browser profile remains local and is ignored by git.
CLAPPING_HANDS_PROFILE_DIR=.data/browser-profile

# Secret-free, portable compiled structure. Raw requests and auth values are
# held in memory only and are never written here.
CLAPPING_HANDS_MARKETPLACE_PLAN=.data/plans/facebook-marketplace-search.json

# Keep false while signing in and dogfooding.
CLAPPING_HANDS_HEADLESS=false

# Optional override when Google Chrome is installed elsewhere.
# CLAPPING_HANDS_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
